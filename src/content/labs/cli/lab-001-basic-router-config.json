{
  "id": "lab-001",
  "title": "Basic Router Configuration",
  "domain": "ip-connectivity",
  "difficulty": "beginner",
  "estimatedMinutes": 15,
  "topology": "single-router",
  "description": "Configure a Cisco router with a hostname, two interface IP addresses, and verify connectivity settings. This lab covers the foundational IOS configuration workflow every CCNA candidate must master.",
  "objectives": ["1.1", "3.1"],
  "initialState": {
    "hostname": "Router",
    "mode": "user"
  },
  "scenario": "You are configuring a new router (R1) that will connect the 192.168.1.0/24 LAN to the 10.0.0.0/30 WAN link. The ISP-facing interface is GigabitEthernet0/0 and the LAN interface is GigabitEthernet0/1.",
  "tasks": [
    {
      "id": "t1",
      "description": "Set the router hostname to R1",
      "hint": "Enter global config mode first with 'configure terminal', then use the 'hostname' command",
      "check": {
        "type": "hostname",
        "description": "Hostname must be R1",
        "expected": { "hostname": "R1" }
      }
    },
    {
      "id": "t2",
      "description": "Configure GigabitEthernet0/0 with IP 10.0.0.1 /30",
      "hint": "Use 'interface GigabitEthernet0/0' then 'ip address 10.0.0.1 255.255.255.252'",
      "check": {
        "type": "interface_ip",
        "description": "Gi0/0 must have IP 10.0.0.1 255.255.255.252",
        "expected": { "interface": "GigabitEthernet0/0", "ip": "10.0.0.1", "mask": "255.255.255.252" }
      }
    },
    {
      "id": "t3",
      "description": "Bring GigabitEthernet0/0 up (no shutdown)",
      "hint": "While in interface config mode, type 'no shutdown'",
      "check": {
        "type": "interface_status",
        "description": "Gi0/0 must be up",
        "expected": { "interface": "GigabitEthernet0/0", "status": "up" }
      }
    },
    {
      "id": "t4",
      "description": "Configure GigabitEthernet0/1 with IP 192.168.1.1 /24",
      "hint": "Use 'interface GigabitEthernet0/1' then 'ip address 192.168.1.1 255.255.255.0'",
      "check": {
        "type": "interface_ip",
        "description": "Gi0/1 must have IP 192.168.1.1 255.255.255.0",
        "expected": { "interface": "GigabitEthernet0/1", "ip": "192.168.1.1", "mask": "255.255.255.0" }
      }
    },
    {
      "id": "t5",
      "description": "Bring GigabitEthernet0/1 up (no shutdown)",
      "hint": "While in interface config mode, type 'no shutdown'",
      "check": {
        "type": "interface_status",
        "description": "Gi0/1 must be up",
        "expected": { "interface": "GigabitEthernet0/1", "status": "up" }
      }
    }
  ],
  "solutionWalkthrough": [
    "enable",
    "configure terminal",
    "hostname R1",
    "interface GigabitEthernet0/0",
    "ip address 10.0.0.1 255.255.255.252",
    "no shutdown",
    "exit",
    "interface GigabitEthernet0/1",
    "ip address 192.168.1.1 255.255.255.0",
    "no shutdown",
    "end",
    "show ip interface brief"
  ]
}
